+/*
+ * Complete Btrfs data checksum.
+ *
+ * Btrfs checksum values are 4, 8, or 32 bytes.  Keep the complete value;
+ * never reduce SHA256/BLAKE2B to 64 bits.
+ *
+ * bucket_key() is only used for selecting the hash-table bucket.  It is
+ * NOT the stored checksum and is never used for checksum equality.
+ */
+struct BeesHash {
+	static constexpr size_t MAX_SIZE = 32;
+
+	BeesHash() : m_size(0), m_hash{} {}
+	BeesHash(const uint8_t *ptr, size_t len) : m_size(len), m_hash{} {
+		THROW_CHECK1(invalid_argument, len, len <= MAX_SIZE);
+		THROW_CHECK1(invalid_argument, ptr, ptr != nullptr || len == 0);
+		if (len) {
+			memcpy(m_hash.data(), ptr, len);
+		}
+	}
+
+	bool empty() const { return m_size == 0; }
+	size_t size() const { return m_size; }
+	const uint8_t *data() const { return m_hash.data(); }
+
+	uint64_t bucket_key() const;
+
+	bool operator==(const BeesHash &that) const {
+		return m_size == that.m_size && m_hash == that.m_hash;
+	}
+	bool operator!=(const BeesHash &that) const {
+		return !(*this == that);
+	}
+	bool operator<(const BeesHash &that) const {
+		if (m_size != that.m_size) return m_size < that.m_size;
+		return m_hash < that.m_hash;
+	}
+
+private:
+	uint8_t m_size;
+	array<uint8_t, MAX_SIZE> m_hash;
+};
+
+ostream & operator<<(ostream &os, const BeesHash &hash);
